---
layout: default
---
<div class="post">
  <header class="post-header">
    <h2 class="post-title">
      {% if page.permalink == '/publications/' %}
        <span data-i18n="page.publications">{{ page.titledisplay }}</span>
      {% elsif page.permalink == '/patents/' %}
        <span data-i18n="page.patents">{{ page.titledisplay }}</span>
      {% elsif page.permalink == '/notes/' %}
        <span data-i18n="page.notes">{{ page.titledisplay }}</span>
      {% else %}
        {{ page.titledisplay }}
      {% endif %}
    </h2>
    {% if page.description_en or page.description_zh %}
      <p class="post-description language-content language-block" data-language-content="en">{{ page.description_en | default: page.description }}</p>
      <p class="post-description language-content language-block" data-language-content="zh">{{ page.description_zh | default: page.description_en | default: page.description }}</p>
    {% else %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2><span data-i18n="page.references">References</span></h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
