<div class="benchmark-performance-panel">
  <div
    id="mt-bench-qwen-chart"
    class="benchmark-performance-chart"
    role="img"
    aria-label="MT-Bench Judge Score（满分 10 分）：Qwen1.5-7B 7.60 分，Qwen2-7B 8.41 分，Qwen2.5-7B 8.75 分。"
    data-benchmark-chart
    data-chart-builder="buildMTBenchQwenOption"
    data-chart-data="mt-bench-qwen-data"
    data-chart-value-key="score"
    data-chart-metric="Judge Score"
    data-chart-value-suffix=" 分"
    data-chart-decimals="2"
    data-runtime-url="https://replit-cdn.com/atta-chart-preview/atta-chart-preview.418e3c54b56c.js"
    data-runtime-integrity="sha256-QY48VLVshImVaPsSP2GDBwpciPdwJa9nI6qgzia8U2k="
  ></div>
  <p class="benchmark-performance-status" role="status" aria-live="polite">正在加载图表…</p>
  <script type="application/json" id="mt-bench-qwen-data">
    {% include charts/mt-bench-qwen.chart.json %}
  </script>
</div>
