<article class="team-student">
  <img class="team-student-photo" src="{{ include.student.photo | relative_url | escape }}" alt="" loading="lazy">
  {% assign student_homepage = include.student.homepage | default: '' | strip %}
  {% assign student_scholar = include.student.google_scholar | default: '' | strip %}
  <div class="team-student-details">
    <h3 class="team-student-name">
      <span class="language-content language-inline" data-language-content="en">{{ include.student.name.en | escape }}</span>
      <span class="language-content language-inline" data-language-content="zh">{{ include.student.name.zh | escape }}</span>
    </h3>
    <p class="team-student-enrollment">
      {% assign enrollment_date = include.student.enrollment | append: '-01' %}
      <span data-i18n="teams.enrollment">Intake</span>
      <span class="language-content language-inline" data-language-content="en">{{ enrollment_date | date: "%b. %Y" | escape }}</span>
      <span class="language-content language-inline" data-language-content="zh">{{ enrollment_date | date: "%Y年%-m月" | escape }}</span>
    </p>
    <nav class="team-student-links" aria-label="Student links">
      {% if include.student.email and include.student.email != '' %}
        <a class="team-student-icon-link" href="mailto:{{ include.student.email | escape }}" title="Email">
          <i class="fa-solid fa-envelope" aria-hidden="true"></i>
          <span class="sr-only" data-i18n="teams.email">Email</span>
        </a>
      {% endif %}
      {% if student_scholar != '' %}
        <a class="team-student-icon-link" href="{{ student_scholar | escape }}" target="_blank" rel="noopener noreferrer" title="Google Scholar">
          <i class="ai ai-google-scholar" aria-hidden="true"></i>
          <span class="sr-only" data-i18n="teams.scholar">Google Scholar</span>
        </a>
      {% endif %}
      {% if student_homepage != '' %}
        <a class="team-student-icon-link" href="{{ student_homepage | escape }}" target="_blank" rel="noopener noreferrer" title="Homepage">
          <i class="fa-solid fa-globe" aria-hidden="true"></i>
          <span class="sr-only" data-i18n="teams.homepage">Homepage</span>
        </a>
      {% endif %}
    </nav>
    <p class="team-student-research">
      <span class="language-content language-inline" data-language-content="en">{{ include.student.research.en | escape }}</span>
      <span class="language-content language-inline" data-language-content="zh">{{ include.student.research.zh | escape }}</span>
    </p>
  </div>
</article>
